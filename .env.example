# =========================================================
# (c) 2026 KI-OS.org by Ingo Schaffer und Kimba
# File: .env.example
# Description:
# Zentrale Beispiel-Umgebungsvariablen für KI-OS Community Edition.
# Multi-Provider: OpenAI, Anthropic, Gemini, DeepSeek, Qwen/DashScope und OpenRouter.
# =========================================================

# --- Core Settings ---
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=*
TZ=Europe/Berlin
LOG_LEVEL=info

# --- Memory Configuration ---
MEMORY_DRIVER=file
LOCAL_MEMORY_FILE=.ki-os-memory.json

# --- XS Gate ---
XS_GATE_ENABLED=true
XS_GATE_CODE=XS

# --- Multi-Provider ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_ENABLED=true

ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_ENABLED=true

GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com
GEMINI_ENABLED=true

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_ENABLED=true

OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_ENABLED=true

# Qwen / Alibaba DashScope (direkte Integration — https://dashscope.aliyuncs.com)
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ENABLED=false
DASHSCOPE_DEFAULT_MODEL=qwen-turbo

# --- Dynamic Model Discovery ---
MODEL_DISCOVERY_ENABLED=true
MODEL_DISCOVERY_REFRESH_ON_BOOT=true
MODEL_DISCOVERY_CACHE_TTL_SECONDS=3600
MODEL_DISCOVERY_TIMEOUT_MS=15000
MODEL_DISCOVERY_ALLOW_PREVIEW=false
MODEL_DISCOVERY_ALLOW_EXPERIMENTAL=false
MODEL_REGISTRY_STRICT=false

# --- Agent Mesh / Router ---
AGENT_LAYER_ENABLED=false
AGENT_MESH_ENABLED=false
AGENT_INTAKE_ENABLED=false
DOMAIN_AGENTS_ENABLED=false
AGENT_AGENTIC_THRESHOLD=0.6
AGENT_EXECUTION_TIMEOUT=120000
AGENT_MAX_RETRIES=2

# --- AgentMesh Role-specific Models (via OpenRouter) ---
# qwen/* und deepseek/* werden automatisch über OpenRouter geroutet.
MESH_MODEL_FULL=claude-haiku-4-5-20251001
MESH_MODEL_CHEAP=claude-haiku-4-5-20251001
MESH_REVIEWER_MODEL=deepseek/deepseek-chat
MESH_RESEARCHER_MODEL=qwen/qwen-2.5-72b-instruct

ROUTER_ENABLED=true
ROUTER_DEBUG=false
ROUTER_DEFAULT_PROVIDER=openai
ROUTER_FAST_PROVIDER=gemini
ROUTER_REASONING_PROVIDER=anthropic
ROUTER_RESEARCH_PROVIDER=openai
ROUTER_CODE_PROVIDER=anthropic
ROUTER_LOW_COST_PROVIDER=deepseek
ROUTER_FALLBACK_PROVIDER=openrouter
ROUTER_VISION_PROVIDER=openai

ROUTER_TRUST_GATE_PERCENT=65
TRUST_SCORE_RESEARCH_MIN=70
TRUST_SCORE_DEFAULT_MIN=40
VERIFIER_FAIL_OPEN=false

# --- Timeouts ---
WEBSEARCH_TIMEOUT_MS=30000
PROVIDER_TIMEOUT_MS=30000
OPENAI_TIMEOUT_MS=30000
OPENAI_DEEP_RESEARCH_TIMEOUT_MS=180000

# --- Deep Research ---
ONEVOICE_DEEP_RESEARCH_ROUTER=true
ONEVOICE_SECONDARY_DEEP_RESEARCH=false
ONEVOICE_SECONDARY_DEEP_RESEARCH_MIN_CONF=0.62
OPENAI_DEEP_RESEARCH_POLL_MS=10000
OPENAI_DEEP_RESEARCH_MAX_MS=1200000
GEMINI_DEEP_RESEARCH_TIMEOUT_MS=180000

# --- Websearch ---
WEBSEARCH_ENABLED=true
WEBSEARCH_PROVIDER=openai
WEBSEARCH_PROVIDER_PRIORITY=openai,anthropic,gemini,openrouter
ROUTER_WEBSEARCH_PROVIDER=openai
ROUTER_WEBSEARCH_FALLBACK_PROVIDER=anthropic
OPENAI_WEBSEARCH_ENABLED=true
ANTHROPIC_WEBSEARCH_ENABLED=true
GEMINI_WEBSEARCH_ENABLED=true
DEEPSEEK_WEBSEARCH_ENABLED=false
OPENROUTER_WEBSEARCH_ENABLED=true

OPENAI_VISION_ENABLED=true
ANTHROPIC_VISION_ENABLED=true
GEMINI_VISION_ENABLED=true
DEEPSEEK_VISION_ENABLED=false
OPENROUTER_VISION_ENABLED=true

OPENAI_CODE_ENABLED=true
ANTHROPIC_CODE_ENABLED=true
GEMINI_CODE_ENABLED=true
DEEPSEEK_CODE_ENABLED=true
OPENROUTER_CODE_ENABLED=true

OPENAI_REASONING_ENABLED=true
ANTHROPIC_REASONING_ENABLED=true
GEMINI_REASONING_ENABLED=true
DEEPSEEK_REASONING_ENABLED=true
OPENROUTER_REASONING_ENABLED=true

# --- Optional Search Providers ---
BRAVE_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=

# --- Automation Webhooks ---
WEBHOOK_STUB_PORT=8787
AUTOMATION_DEFAULT_TIMEOUT_MS=10000
AUTOMATION_CALLBACK_TIMEOUT_MS=15000
AUTOMATION_RATE_LIMIT_PER_MINUTE=60
HUB_N8N_CUSTOMER_SYNC_URL=
HUB_N8N_CUSTOMER_SYNC_SECRET=
HUB_MAKE_ORDER_ALERT_URL=
HUB_MAKE_ORDER_ALERT_SECRET=
HUB_ZAPIER_NEW_LEAD_URL=
HUB_ZAPIER_NEW_LEAD_SECRET=
HUB_HTTP_SAP_PROXY_URL=
HUB_HTTP_SAP_PROXY_SECRET=

# --- Control Console ---
CONTROL_CONSOLE_ENABLED=true
UI_EVENT_HISTORY_LIMIT=200
UI_AUDIT_LIMIT=500

# --- Telemetry ---
# Sendet: zufällige Instance-ID, Version, Platform — KEINE Userdaten
# Opt-out: auf false setzen
KI_OS_TELEMETRY=true

# ── KI-OS License Keys ────────────────────────────────────
# Community Edition: no key needed
# KIOS_BUSINESS_KEY=      # Business Edition — ki-os.org/business
# KIOS_ENTERPRISE_KEY=    # Enterprise Edition — enterprise@ki-os.org

# ── KIMBA Discord Bot ──────────────────────────────────────
# Token: Discord Developer Portal → Bot → Reset Token — NIEMALS committen!
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=1493200630208587848
DISCORD_GUILD_ID=1493193129073840168
DISCORD_CHANNEL_GENERAL=1493202186283389099
DISCORD_CHANNEL_RULES=1493208582345195601
DISCORD_CHANNEL_ANNOUNCEMENTS=1493202169120428196
DISCORD_CHANNEL_RELEASES=1493202173939548356
DISCORD_CHANNEL_SUPPORT=1493202206793662464
DISCORD_CHANNEL_SHOWCASE=1493202194210619432
DISCORD_ROLE_COMMUNITY=1493202377468153987
DISCORD_ROLE_BUILDER=1493202381393891413
DISCORD_ROLE_ENTERPRISE=1493202385739452436
DISCORD_ROLE_TEAM=1493202389686026320
DISCORD_WEBHOOK_RELEASES=
# KI-OS API für /ask — Default: localhost:8080
KI_OS_API_URL=http://localhost:8080

# ── Dogado FTP (ki-os.org Web-Deploy) ──────────────
FTP_HOST=web301.dogado.net
FTP_PORT=21
FTP_USER=
FTP_PASS=
