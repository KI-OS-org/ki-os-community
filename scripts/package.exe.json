{
  "name": "ki-os-community-launcher",
  "version": "1.1.1-security",
  "description": "KI-OS Community Edition Launcher",
  "main": "launcher.js",
  "bin": "launcher.js",
  "pkg": {
    "scripts": [
      "backend/**/*.js",
      "core/**/*.js",
      "runtime/**/*.js"
    ],
    "assets": [
      "Web/**/*",
      "node_modules/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "build:exe": "pkg . --output KI-OS-Community.exe"
  }
}
