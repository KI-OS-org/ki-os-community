{
  "profileId": "teams",
  "tier": "enterprise",
  "name": "Microsoft Teams",
  "category": "communication",
  "protocol": "mcp",
  "trustLevel": "standard",
  "authType": "bearer",
  "capabilities": ["msg.send", "msg.receive", "channel.post", "meeting.create"],
  "webhookPattern": "https://outlook.office.com/webhook/{tenantId}@{tenantId}/IncomingWebhook/{id}/{token}",
  "headers": {
    "Content-Type": "application/json",
    "Authorization": "Bearer {accessToken}"
  },
  "events": ["message.received", "channel.created", "meeting.started", "user.mentioned"],
  "payloadSchema": {
    "type": "object",
    "properties": {
      "@type": { "type": "string", "default": "MessageCard" },
      "@context": { "type": "string", "default": "https://schema.org/extensions" },
      "title": { "type": "string" },
      "text": { "type": "string" },
      "themeColor": { "type": "string" }
    }
  },
  "docs": "https://learn.microsoft.com/en-us/microsoftteams/platform/webhooks-and-connectors"
}
